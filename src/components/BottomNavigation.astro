---
const { page = 'landing', active = 'home' } = Astro.props;
const isTournament = page === 'tournament';
const items = [
    { key: 'home', label: 'Inicio', icon: '🏠', href: '/' },
    { key: 'participants', label: 'Participantes', icon: '👥', href: '/app/?tab=participants' },
    { key: 'matches', label: 'VS', icon: '⚔️', href: '/app/?tab=matches' },
    { key: 'table', label: 'Tabla', icon: '📊', href: '/app/?tab=table' },
    { key: 'profile', label: 'Perfil', icon: '👤', href: '/p/' }
];

if (page === 'view') {
    items.find(item => item.key === 'matches').href = '#matchesSection';
    items.find(item => item.key === 'table').href = '#standingsSection';
}
---

<nav class="persistent-navigation" aria-label="Navegación principal">
    {items.map((item) => {
        const selected = active === item.key;
        const className = isTournament && !['home', 'profile'].includes(item.key)
            ? `persistent-navigation-tab${selected ? ' active' : ''}`
            : selected ? 'active' : '';
        const current = selected ? (page === 'view' ? 'location' : 'page') : undefined;

        return isTournament && !['home', 'profile'].includes(item.key) ? (
            <button class={className} data-tab={item.key} type="button" title={item.label} aria-selected={selected}>
                <span class="tab-icon" aria-hidden="true">{item.icon}</span>
                <span>{item.label}</span>
            </button>
        ) : (
            <a class={className} href={item.href} title={item.label} aria-current={current}>
                <span class="tab-icon" aria-hidden="true">{item.icon}</span>
                <span>{item.label}</span>
            </a>
        );
    })}
</nav>
