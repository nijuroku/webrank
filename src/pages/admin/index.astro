---
import AppLayout from '../../layouts/AppLayout.astro';
import BottomNavigation from '../../components/BottomNavigation.astro';
import '../../styles/admin.css';
import '../../styles/navigation.css';
import '../../styles/loading.css';
---

<AppLayout page="admin" title="Administración · LaMafia" description="Administración de LaMafia BEYBLADEX." themeColor="#0b1726">
<main class="admin-shell">
        <header class="admin-header">
            <div>
                <a class="back-link" href="/">← Volver a LaMafia</a>
                <h1>Administración</h1>
                <p>Alias de jugadores y gestión de torneos</p>
            </div>
            <button id="logoutButton" class="button secondary" type="button" hidden>Cerrar sesión</button>
        </header>

        <div id="notice" class="notice" role="status" aria-live="polite" hidden></div>

        <section id="loginPanel" class="panel login-panel">
            <h2>Acceso de administrador</h2>
            <p>Inicia sesión con la cuenta autorizada en Supabase.</p>
            <form id="loginForm">
                <label for="loginEmail">Correo</label>
                <input id="loginEmail" type="email" autocomplete="username" required>
                <label for="loginPassword">Contraseña</label>
                <input id="loginPassword" type="password" autocomplete="current-password" required>
                <button class="button primary" type="submit">Entrar</button>
            </form>
        </section>

        <section id="adminPanel" hidden>
            <section class="panel">
                <div class="section-heading">
                    <div>
                        <h2>Solicitudes de torneos</h2>
                        <p>Las tablas finales anónimas esperan aprobación antes de guardarse.</p>
                    </div>
                </div>
                <div id="tournamentSubmissionList" class="list" aria-live="polite"></div>
            </section>

            <section class="panel">
                <div class="section-heading">
                    <div>
                        <h2>Registro de actividad</h2>
                        <p>Creaciones, solicitudes, publicaciones y cierres.</p>
                    </div>
                </div>
                <div id="activityLog" class="log-console" role="log" aria-live="polite"></div>
            </section>

            <section class="panel">
                <div class="section-heading">
                    <div>
                        <h2>Torneos activos</h2>
                        <p>Cerrar un torneo revoca su enlace público de inmediato.</p>
                    </div>
                </div>
                <div id="activeTournamentList" class="list" aria-live="polite"></div>
            </section>

            <section class="panel">
                <div class="section-heading">
                    <div>
                        <h2>Vincular nombres</h2>
                        <p>El alias llevará al perfil y al historial del jugador principal.</p>
                    </div>
                </div>
                <form id="aliasForm" class="alias-form">
                    <div class="field">
                        <label for="aliasName">Nombre alternativo</label>
                        <input id="aliasName" maxlength="100" placeholder="Gabo" required>
                    </div>
                    <div class="field">
                        <label for="canonicalName">Jugador principal</label>
                        <select id="canonicalName" required></select>
                    </div>
                    <button class="button primary" type="submit">Vincular</button>
                </form>
                <div id="aliasList" class="list" aria-live="polite"></div>
            </section>

            <section class="panel">
                <div class="section-heading">
                    <div>
                        <h2>Solicitudes de perfiles</h2>
                        <p>Aprueba una solicitud para vincular el jugador a la cuenta del solicitante.</p>
                    </div>
                </div>
                <div id="profileRequestsList" class="list" aria-live="polite"></div>
            </section>

            <section class="panel">
                <div class="section-heading">
                    <div>
                        <h2>Torneos guardados</h2>
                        <p>Eliminar un torneo borra su tabla final e historial guardado.</p>
                    </div>
                    <button id="refreshButton" class="button secondary" type="button">Actualizar</button>
                </div>
                <div id="tournamentList" class="list" aria-live="polite"></div>
            </section>
        </section>
    </main>
    <BottomNavigation slot="navigation" page="admin" active="none" />
    <script>
        import '../../scripts/admin.js';
    </script>
</AppLayout>
