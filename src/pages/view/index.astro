---
import AppLayout from '../../layouts/AppLayout.astro';
import BottomNavigation from '../../components/BottomNavigation.astro';
import '../../styles/viewer.css';
import '../../styles/navigation.css';
import '../../styles/loading.css';
---

<AppLayout page="view" title="Torneo en vivo · LaMafia BEYBLADEX" description="Consulta en vivo las rondas y la tabla de un torneo LaMafia BEYBLADEX." themeColor="#10111c">
<header class="viewer-header">
        <a class="brand" href="/" aria-label="Volver a LaMafia"><span class="brand-mark" aria-hidden="true">⚔️</span><span>LaMafia <strong>BEYBLADEX</strong></span></a>
        <div class="header-actions">
            <span class="readonly-label">Solo lectura</span>
            <button class="theme-mode-toggle" id="themeToggleBtn" type="button" aria-pressed="false"
                aria-label="Cambiar al modo claro" title="Cambiar al modo claro">
                <span class="theme-mode-track" aria-hidden="true"><span class="theme-mode-thumb"></span></span>
                <span class="theme-mode-label">Oscuro</span>
            </button>
        </div>
    </header>

    <main class="viewer-main">
        <div class="live-status" aria-live="polite">
            <span class="live-dot" id="liveDot"></span>
            <span id="connectionStatus">Conectando al torneo…</span>
            <span class="updated-at" id="updatedAt"></span>
        </div>

        <section class="message-card viewer-loading-state" id="loadingState" aria-label="Cargando torneo" aria-live="polite">
            <span class="sr-only">Cargando torneo…</span>
            <div class="viewer-loading-skeleton" aria-hidden="true">
                <div class="loading-skeleton viewer-loading-heading"></div>
                <div class="viewer-loading-content">
                    <div class="viewer-loading-matches">
                        <span class="loading-skeleton skeleton-line short"></span>
                        <div class="viewer-loading-match-grid">
                            <span class="loading-skeleton skeleton-card"></span><span class="loading-skeleton skeleton-card"></span>
                            <span class="loading-skeleton skeleton-card"></span><span class="loading-skeleton skeleton-card"></span>
                        </div>
                    </div>
                    <div class="viewer-loading-table">
                        <span class="loading-skeleton skeleton-line medium"></span>
                        <span class="loading-skeleton skeleton-card"></span><span class="loading-skeleton skeleton-card"></span>
                        <span class="loading-skeleton skeleton-card"></span><span class="loading-skeleton skeleton-card"></span>
                    </div>
                </div>
            </div>
        </section>
        <section class="message-card error-card" id="errorState" hidden></section>

        <div id="tournamentView" hidden>
            <section class="tournament-heading">
                <p class="eyebrow" id="phaseLabel">Torneo en vivo</p>
                <h1 id="tournamentName">Torneo</h1>
                <div class="tournament-meta" id="tournamentMeta"></div>
                <p class="readonly-note">Los resultados se actualizan automáticamente. Esta página no permite editar el torneo.</p>
            </section>

            <section class="rounds-card" id="matchesSection">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Enfrentamientos</p>
                        <h2>Rondas</h2>
                    </div>
                    <span class="round-count" id="roundCount"></span>
                </div>
                <nav class="round-navigation" id="roundNavigation" aria-label="Seleccionar ronda"></nav>
                <div class="matches-grid" id="matchesList"></div>
            </section>

            <section class="standings-card" id="standingsSection">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Puntaje acumulado</p>
                        <h2>Tabla</h2>
                    </div>
                    <span class="player-count" id="playerCount"></span>
                </div>
                <div class="table-scroll">
                    <table>
                        <thead>
                            <tr><th>#</th><th>Jugador</th><th>Puntos</th><th>Dif.</th><th>G-P-E</th></tr>
                        </thead>
                        <tbody id="standingsBody"></tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>
    <footer>LaMafia BEYBLADEX · Torneo compartido en vivo</footer>
    <BottomNavigation slot="navigation" page="view" active="matches" />
    <script>
        import '../../scripts/viewer.js';
    </script>
</AppLayout>
