{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/p/:player",
      "destination": "/p/index.html?player=:player"
    },
    {
      "source": "/p/:player/",
      "destination": "/p/index.html?player=:player"
    }
  ]
}
