{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/p",
      "destination": "/p/index.html?account=1"
    },
    {
      "source": "/p/",
      "destination": "/p/index.html?account=1"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/p/:player",
      "destination": "/p/index.html?player=:player"
    },
    {
      "source": "/p/:player/",
      "destination": "/p/index.html?player=:player"
    }
  ]
}
